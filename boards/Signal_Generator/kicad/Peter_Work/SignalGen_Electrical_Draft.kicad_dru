(version 1)
# PROVISIONAL BENCH LAYOUT. This is not an insulation-system qualification.
(rule "General copper spacing" (constraint clearance (min 0.2mm)))
# U4/U7 now use the TI 1.40 x 0.45 mm example lands; no package clearance exception.
(rule "Provisional isolation domain spacing 1" (condition "((A.NetName == '/FAULT_TO_PICO' || A.NetName == '/FAULT_TO_PICO_2' || A.NetName == '/SPI_CS_SYS' || A.NetName == '/SPI_CS_SYS_2' || A.NetName == '/SPI_MOSI_SYS' || A.NetName == '/SPI_SCLK_SYS' || A.NetName == '/SYS_3V3' || A.NetName == '/SYS_GND' || A.NetName == '/VBUS_5V' || A.NetName == '/VBUS_5V_2' || A.NetName == 'unconnected-(U1-OUTD-Pad5)' || A.NetName == 'unconnected-(U6-OUTD-Pad5)' || (A.Type == 'Pad' && A.memberOfFootprint('U1') && A.Pad_Number == '5') || (A.Type == 'Pad' && A.memberOfFootprint('U6') && A.Pad_Number == '5')) && (B.NetName == '/BIPOLAR_OUT' || B.NetName == '/CS_ISO' || B.NetName == '/DAC_OUT_UNIPOLAR' || B.NetName == '/IN-_B' || B.NetName == '/ISO_3V3_CLEAN' || B.NetName == '/ISO_3V3_RAW' || B.NetName == '/ISO_GND_ISOW' || B.NetName == '/ISO_N5V' || B.NetName == '/ISO_P5V' || B.NetName == '/MOSI_ISO' || B.NetName == '/SCLK_ISO' || B.NetName == '/VREF_BUF' || B.NetName == 'unconnected-(U1-IND-Pad16)' || (B.Type == 'Pad' && B.memberOfFootprint('U1') && B.Pad_Number == '16'))) || ((A.NetName == '/BIPOLAR_OUT' || A.NetName == '/CS_ISO' || A.NetName == '/DAC_OUT_UNIPOLAR' || A.NetName == '/IN-_B' || A.NetName == '/ISO_3V3_CLEAN' || A.NetName == '/ISO_3V3_RAW' || A.NetName == '/ISO_GND_ISOW' || A.NetName == '/ISO_N5V' || A.NetName == '/ISO_P5V' || A.NetName == '/MOSI_ISO' || A.NetName == '/SCLK_ISO' || A.NetName == '/VREF_BUF' || A.NetName == 'unconnected-(U1-IND-Pad16)' || (A.Type == 'Pad' && A.memberOfFootprint('U1') && A.Pad_Number == '16')) && (B.NetName == '/FAULT_TO_PICO' || B.NetName == '/FAULT_TO_PICO_2' || B.NetName == '/SPI_CS_SYS' || B.NetName == '/SPI_CS_SYS_2' || B.NetName == '/SPI_MOSI_SYS' || B.NetName == '/SPI_SCLK_SYS' || B.NetName == '/SYS_3V3' || B.NetName == '/SYS_GND' || B.NetName == '/VBUS_5V' || B.NetName == '/VBUS_5V_2' || B.NetName == 'unconnected-(U1-OUTD-Pad5)' || B.NetName == 'unconnected-(U6-OUTD-Pad5)' || (B.Type == 'Pad' && B.memberOfFootprint('U1') && B.Pad_Number == '5') || (B.Type == 'Pad' && B.memberOfFootprint('U6') && B.Pad_Number == '5')))") (constraint clearance (min 3.5mm)))
(rule "Provisional isolation domain spacing 2" (condition "((A.NetName == '/FAULT_TO_PICO' || A.NetName == '/FAULT_TO_PICO_2' || A.NetName == '/SPI_CS_SYS' || A.NetName == '/SPI_CS_SYS_2' || A.NetName == '/SPI_MOSI_SYS' || A.NetName == '/SPI_SCLK_SYS' || A.NetName == '/SYS_3V3' || A.NetName == '/SYS_GND' || A.NetName == '/VBUS_5V' || A.NetName == '/VBUS_5V_2' || A.NetName == 'unconnected-(U1-OUTD-Pad5)' || A.NetName == 'unconnected-(U6-OUTD-Pad5)' || (A.Type == 'Pad' && A.memberOfFootprint('U1') && A.Pad_Number == '5') || (A.Type == 'Pad' && A.memberOfFootprint('U6') && A.Pad_Number == '5')) && (B.NetName == '/BIPOLAR_OUT_2' || B.NetName == '/CS_ISO_2' || B.NetName == '/DAC_OUT_UNIPOLAR_2' || B.NetName == '/IN-_B_2' || B.NetName == '/ISO_3V3_CLEAN_2' || B.NetName == '/ISO_3V3_RAW_2' || B.NetName == '/ISO_GND_ISOW_2' || B.NetName == '/ISO_N5V_2' || B.NetName == '/ISO_P5V_2' || B.NetName == '/MOSI_ISO_2' || B.NetName == '/SCLK_ISO_2' || B.NetName == '/VREF_BUF_2' || B.NetName == 'unconnected-(U6-IND-Pad16)' || (B.Type == 'Pad' && B.memberOfFootprint('U6') && B.Pad_Number == '16'))) || ((A.NetName == '/BIPOLAR_OUT_2' || A.NetName == '/CS_ISO_2' || A.NetName == '/DAC_OUT_UNIPOLAR_2' || A.NetName == '/IN-_B_2' || A.NetName == '/ISO_3V3_CLEAN_2' || A.NetName == '/ISO_3V3_RAW_2' || A.NetName == '/ISO_GND_ISOW_2' || A.NetName == '/ISO_N5V_2' || A.NetName == '/ISO_P5V_2' || A.NetName == '/MOSI_ISO_2' || A.NetName == '/SCLK_ISO_2' || A.NetName == '/VREF_BUF_2' || A.NetName == 'unconnected-(U6-IND-Pad16)' || (A.Type == 'Pad' && A.memberOfFootprint('U6') && A.Pad_Number == '16')) && (B.NetName == '/FAULT_TO_PICO' || B.NetName == '/FAULT_TO_PICO_2' || B.NetName == '/SPI_CS_SYS' || B.NetName == '/SPI_CS_SYS_2' || B.NetName == '/SPI_MOSI_SYS' || B.NetName == '/SPI_SCLK_SYS' || B.NetName == '/SYS_3V3' || B.NetName == '/SYS_GND' || B.NetName == '/VBUS_5V' || B.NetName == '/VBUS_5V_2' || B.NetName == 'unconnected-(U1-OUTD-Pad5)' || B.NetName == 'unconnected-(U6-OUTD-Pad5)' || (B.Type == 'Pad' && B.memberOfFootprint('U1') && B.Pad_Number == '5') || (B.Type == 'Pad' && B.memberOfFootprint('U6') && B.Pad_Number == '5')))") (constraint clearance (min 3.5mm)))
(rule "Provisional isolation domain spacing 3" (condition "((A.NetName == '/BIPOLAR_OUT' || A.NetName == '/CS_ISO' || A.NetName == '/DAC_OUT_UNIPOLAR' || A.NetName == '/IN-_B' || A.NetName == '/ISO_3V3_CLEAN' || A.NetName == '/ISO_3V3_RAW' || A.NetName == '/ISO_GND_ISOW' || A.NetName == '/ISO_N5V' || A.NetName == '/ISO_P5V' || A.NetName == '/MOSI_ISO' || A.NetName == '/SCLK_ISO' || A.NetName == '/VREF_BUF' || A.NetName == 'unconnected-(U1-IND-Pad16)' || (A.Type == 'Pad' && A.memberOfFootprint('U1') && A.Pad_Number == '16')) && (B.NetName == '/BIPOLAR_OUT_2' || B.NetName == '/CS_ISO_2' || B.NetName == '/DAC_OUT_UNIPOLAR_2' || B.NetName == '/IN-_B_2' || B.NetName == '/ISO_3V3_CLEAN_2' || B.NetName == '/ISO_3V3_RAW_2' || B.NetName == '/ISO_GND_ISOW_2' || B.NetName == '/ISO_N5V_2' || B.NetName == '/ISO_P5V_2' || B.NetName == '/MOSI_ISO_2' || B.NetName == '/SCLK_ISO_2' || B.NetName == '/VREF_BUF_2' || B.NetName == 'unconnected-(U6-IND-Pad16)' || (B.Type == 'Pad' && B.memberOfFootprint('U6') && B.Pad_Number == '16'))) || ((A.NetName == '/BIPOLAR_OUT_2' || A.NetName == '/CS_ISO_2' || A.NetName == '/DAC_OUT_UNIPOLAR_2' || A.NetName == '/IN-_B_2' || A.NetName == '/ISO_3V3_CLEAN_2' || A.NetName == '/ISO_3V3_RAW_2' || A.NetName == '/ISO_GND_ISOW_2' || A.NetName == '/ISO_N5V_2' || A.NetName == '/ISO_P5V_2' || A.NetName == '/MOSI_ISO_2' || A.NetName == '/SCLK_ISO_2' || A.NetName == '/VREF_BUF_2' || A.NetName == 'unconnected-(U6-IND-Pad16)' || (A.Type == 'Pad' && A.memberOfFootprint('U6') && A.Pad_Number == '16')) && (B.NetName == '/BIPOLAR_OUT' || B.NetName == '/CS_ISO' || B.NetName == '/DAC_OUT_UNIPOLAR' || B.NetName == '/IN-_B' || B.NetName == '/ISO_3V3_CLEAN' || B.NetName == '/ISO_3V3_RAW' || B.NetName == '/ISO_GND_ISOW' || B.NetName == '/ISO_N5V' || B.NetName == '/ISO_P5V' || B.NetName == '/MOSI_ISO' || B.NetName == '/SCLK_ISO' || B.NetName == '/VREF_BUF' || B.NetName == 'unconnected-(U1-IND-Pad16)' || (B.Type == 'Pad' && B.memberOfFootprint('U1') && B.Pad_Number == '16')))") (constraint clearance (min 3.5mm)))

(symbol (lib_id "MonitorReview:Part_J7") (at 764.54 723.9 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "84a4bb19-84b2-4b27-89d8-889b293e3103") (property "Reference" "J7" (at 764.54 715.01 0) (effects (font (size 1.0 1.0))))(property "Value" "HV_RAIL_MONITOR" (at 764.54 717.55 0) (effects (font (size 1.0 1.0))))(property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (at 764.54 723.9 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "TSW-103-07-G-S" (at 764.54 723.9 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "3-position, single-row, straight through-hole, 2.54 mm pitch, 0.635 mm square post. Unshrouded and UNPOLARIZED: pin-1 marking and verified cable mapping are required; this is not a keyed connector. Official layout recommends 1.02 mm finished holes. Standard KiCad footprint has 1.00 mm holes; use 1.02 mm nominal or a documented 1.05 mm production nominal and rerun DRC/parity. Pad centers, copper pad size and routing need not change. Lead style 07: 5.84 mm post, 2.54 mm tail. J4 is optional/unconnected unless an existing documented Howland enable connection is available; do not modify the Howland board." (at 764.54 723.9 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (at 764.54 723.9 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "148fc631-9db2-4173-8c07-23230d61959d")) (pin "2" (uuid "ebcba91b-1d93-4524-a24f-6d260fd78cfa")) (pin "3" (uuid "6692e507-9bb7-45c3-b346-03de4a8961ce"))(instances (project "Channel_Monitor_C1" (path "/458b5747-2e85-45a1-9187-f8f0b762d2d2" (reference "J7") (unit 1)))))

(symbol (lib_id "MonitorReview:Part_U15") (at 345.44 680.72 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "5a5f4007-563f-4746-99d5-2796c1c30d99") (property "Reference" "U15" (at 345.44 670.56 0) (effects (font (size 1.0 1.0))))(property "Value" "TPS3808G01" (at 345.44 673.1 0) (effects (font (size 1.0 1.0))))(property "Footprint" "Package_TO_SOT_SMD:SOT-23-6" (at 345.44 680.72 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "TPS3808G01DBVR" (at 345.44 680.72 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "Condition wired comparator fault into a guaranteed low logic level. MR VIL=0.3VDD accommodates TLV170x low output <=0.9 V only while valid 3.3 V rail is above supervisor threshold. Output asserts after MR propagation, nominal 150 ns, then releases 12..28 ms after raw fault clears. No guaranteed maximum fault latency is claimed." (at 345.44 680.72 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "Package_TO_SOT_SMD:SOT-23-6" (at 345.44 680.72 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "770c2eec-4a46-4ef1-af3f-43ee19f1fbc5")) (pin "2" (uuid "9811787e-f8fb-4ee9-b7fe-62a3654c2fa0")) (pin "3" (uuid "d6fedac8-8eab-41c3-83cc-880505a317f1")) (pin "4" (uuid "92a76e76-41ca-469a-93a6-1828f6c1f69e")) (pin "5" (uuid "c3e8dbda-d091-43ba-87fd-cead80b650c9")) (pin "6" (uuid "796b16c8-5401-4bcf-965c-856b3a4b9172"))(instances (project "Channel_Monitor_C1" (path "/458b5747-2e85-45a1-9187-f8f0b762d2d2" (reference "U15") (unit 1)))))

(symbol (lib_id "MonitorReview:Part_J1") (at 345.44 378.46 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "ecaa5ef3-32c1-4e02-83c0-0bff1e804d4c") (property "Reference" "J1" (at 345.44 369.57 0) (effects (font (size 1.0 1.0))))(property "Value" "ISOLATED_LOCAL_POWER" (at 345.44 372.11 0) (effects (font (size 1.0 1.0))))(property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical" (at 345.44 378.46 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "TSW-104-07-G-S" (at 345.44 378.46 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "4-position, single-row, straight through-hole, 2.54 mm pitch, 0.635 mm square post. Unshrouded and UNPOLARIZED: pin-1 marking and verified cable mapping are required; this is not a keyed connector. Official layout recommends 1.02 mm finished holes. Standard KiCad footprint has 1.00 mm holes; use 1.02 mm nominal or a documented 1.05 mm production nominal and rerun DRC/parity. Pad centers, copper pad size and routing need not change. Lead style 07: 5.84 mm post, 2.54 mm tail. J4 is optional/unconnected unless an existing documented Howland enable connection is available; do not modify the Howland board." (at 345.44 378.46 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical" (at 345.44 378.46 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "dfc0ccbb-b1fa-4ab4-8db2-bf97a632c88f")) (pin "2" (uuid "493de1f6-a631-4010-ac90-794c500688c6")) (pin "3" (uuid "639fa282-402c-4e43-b31e-d7bff02c1fc1")) (pin "4" (uuid "949c134f-7392-4cd0-8b09-b8d48e400c8e"))(instances (project "Channel_Monitor_C1" (path "/458b5747-2e85-45a1-9187-f8f0b762d2d2" (reference "J1") (unit 1)))))

(symbol (lib_id "MonitorReview:Part_C13") (at 205.74 378.46 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "0c7a03bd-33bb-4ac7-b384-200aa053df37") (property "Reference" "C13" (at 205.74 370.84 0) (effects (font (size 1.0 1.0))))(property "Value" "22u 25V X5R" (at 205.74 373.38 0) (effects (font (size 1.0 1.0))))(property "Footprint" "Capacitor_SMD:C_0805_2012Metric" (at 205.74 378.46 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "C2012X5R1E226M125AC" (at 205.74 378.46 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "Increase nominal output capacitance from 10 to 22 uF in the same 0805 footprint. 22 uF +/-20%, 25 V, X5R, 2.0 x 1.25 x 1.25 mm. REF5040A permits 1-50 uF output capacitance; even +20% tolerance and +15% temperature change give 30.36 uF nominal upper estimate. Effective capacitance at 4.096 V is NOT guaranteed here. Manufacturer characterization data are typical; qualify reference noise/transients on the assembled board. X5R rating limits this component to +85 C. No footprint, pad or net change." (at 205.74 378.46 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "Capacitor_SMD:C_0805_2012Metric" (at 205.74 378.46 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "6d526e3b-4949-4af0-8eb8-e352b6342bb0")) (pin "2" (uuid "2ba7647d-915b-482a-a51f-97a34e9f981b"))(instances (project "Channel_Monitor_C1" (path "/458b5747-2e85-45a1-9187-f8f0b762d2d2" (reference "C13") (unit 1)))))

(symbol (lib_id "MonitorReview:Part_U14") (at 205.74 680.72 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "0efd7089-85e5-4968-8d75-6661bdc07a8f") (property "Reference" "U14" (at 205.74 670.56 0) (effects (font (size 1.0 1.0))))(property "Value" "TPS3808G01" (at 205.74 673.1 0) (effects (font (size 1.0 1.0))))(property "Footprint" "Package_TO_SOT_SMD:SOT-23-6" (at 205.74 680.72 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "TPS3808G01DBVR" (at 205.74 680.72 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "TPS3808G01 command qualification timer. CT connected to VDD through 49.9k gives 180/300/420 ms release delay after ZERO_RAW rises. MR going low resets immediately; no passive diode residual/stale RC permission. SENSE directly monitors VDD >0.405 V; separate G33 supervisor enforces valid logic supply." (at 205.74 680.72 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "Package_TO_SOT_SMD:SOT-23-6" (at 205.74 680.72 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "652ca1ac-cb2a-46a3-a08a-34d3d8fff800")) (pin "2" (uuid "c2715a23-c64b-4975-9157-1336b7c8b141")) (pin "3" (uuid "155cf550-d5f7-439d-a094-12b36c16faa4")) (pin "4" (uuid "72a295cf-504d-4866-a750-4be6d489f8a6")) (pin "5" (uuid "278aa71b-2a7f-40bb-a8ba-4b481b4c2ffb")) (pin "6" (uuid "7ec87106-66a7-4c56-bc0f-6a3642ce69e7"))(instances (project "Channel_Monitor_C1" (path "/458b5747-2e85-45a1-9187-f8f0b762d2d2" (reference "U14") (unit 1)))))

(symbol (lib_id "MonitorReview:Part_J101") (at 345.44 810.26 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "7229f849-ad35-401c-8210-96918e390e21") (property "Reference" "J101" (at 345.44 801.37 0) (effects (font (size 1.0 1.0))))(property "Value" "EXTERNAL_DUMMY_LOAD" (at 345.44 803.91 0) (effects (font (size 1.0 1.0))))(property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (at 345.44 810.26 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "TSW-102-07-G-S" (at 345.44 810.26 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "2-position, single-row, straight through-hole, 2.54 mm pitch, 0.635 mm square post. Unshrouded and UNPOLARIZED: pin-1 marking and verified cable mapping are required; this is not a keyed connector. Official layout recommends 1.02 mm finished holes. Standard KiCad footprint has 1.00 mm holes; use 1.02 mm nominal or a documented 1.05 mm production nominal and rerun DRC/parity. Pad centers, copper pad size and routing need not change. Lead style 07: 5.84 mm post, 2.54 mm tail. J4 is optional/unconnected unless an existing documented Howland enable connection is available; do not modify the Howland board." (at 345.44 810.26 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (at 345.44 810.26 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "62e681ae-7b30-4df9-9e41-423f2a8a5383")) (pin "2" (uuid "06402ec6-67b0-4b67-91c5-89768ed67f1e"))(instances (project "Channel_Monitor_C1" (path "/458b5747-2e85-45a1-9187-f8f0b762d2d2" (reference "J101") (unit 1)))))

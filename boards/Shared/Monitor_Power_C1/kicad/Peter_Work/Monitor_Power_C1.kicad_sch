(symbol (lib_id "MonitorPowerReview:Part_R201") (at 205.74 119.38 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "516a63b4-be49-49f2-b075-bf326d7c485c") (property "Reference" "R201" (at 205.74 111.76 0) (effects (font (size 1.0 1.0))))(property "Value" "150R_1%_0.6W" (at 205.74 114.3 0) (effects (font (size 1.0 1.0))))(property "Footprint" "MonitorPowerLocal:Resistor_THT_R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal" (at 205.74 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "MRS25000C1500FRP00" (at 205.74 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "Positive TMR 3 preload. 150 ohm, 1%, 50 ppm/K, 0.6 W at 70 C. At the 4.84 V rail corner it draws at least 31.95 mA, above the 30 mA lower load-regulation test point. Body maximum 6.5 x 2.5 mm; lead pitch selected 10.16 mm. Additional to sensing-core bleeders." (at 205.74 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "MonitorPowerLocal:Resistor_THT_R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal" (at 205.74 119.38 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "78c3c43f-cf35-449c-ba6a-7b95b7c35d97")) (pin "2" (uuid "96588a0e-f589-4c4b-b0de-8be07d4464e1"))(instances (project "Monitor_Power_C1" (path "/ac757bb2-b6c1-4155-aa1b-bd1d9377b81c" (reference "R201") (unit 1)))))

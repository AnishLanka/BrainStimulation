(symbol (lib_id "MonitorPowerReview:Part_PS201") (at 485.14 76.2 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "780144b1-5297-408a-9bf4-b6d901d84686") (property "Reference" "PS201" (at 485.14 64.77 0) (effects (font (size 1.0 1.0))))(property "Value" "ISOLATED_REGULATED_5V_600mA" (at 485.14 67.31 0) (effects (font (size 1.0 1.0))))(property "Footprint" "MonitorPowerLocal:ProtectionLocal_TRACO_TMR3_SIP8_Single" (at 485.14 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "TMR 3-0511" (at 485.14 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "Upgraded for local Pico and ADC load. TMR 3-0511 single output: 5 V / 600 mA, 3 W, input 4.5 to 9 V. Remote pin 3 open means ON. Pin 4 is absent; physical pins 5 and 8 are NC. Pin 6 is +5, pin 7 is channel MID. Keep primary isolated. Custom footprint follows the visually checked official 15-Apr-2026 SIP8 drawing; verify a physical part before assembly." (at 485.14 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "MonitorPowerLocal:ProtectionLocal_TRACO_TMR3_SIP8_Single" (at 485.14 76.2 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "3dbece90-d2b6-49a2-96f1-1a39b58f6b72")) (pin "2" (uuid "25bef7cf-834c-43fc-9ff9-54e76360a887")) (pin "3" (uuid "5e2be3aa-3a17-4a68-b20a-7f7b3d4b7c1c")) (pin "5" (uuid "dd5c3804-e23f-41a9-846d-dae45f0ebb80")) (pin "6" (uuid "0664eb82-b1bc-4266-8233-d7b57c43012b")) (pin "7" (uuid "5745405b-d414-4e6c-b1d3-ff3ad892c556")) (pin "8" (uuid "829af2ec-0445-444e-8b5a-00145560361e"))(instances (project "Monitor_Power_C1" (path "/ac757bb2-b6c1-4155-aa1b-bd1d9377b81c" (reference "PS201") (unit 1)))))

(symbol (lib_id "MonitorPowerReview:Part_U201") (at 485.14 119.38 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "0590ca7f-2eb6-41aa-af48-73bfe1e57ffa") (property "Reference" "U201" (at 485.14 110.49 0) (effects (font (size 1.0 1.0))))(property "Value" "MCP1702_3V3" (at 485.14 113.03 0) (effects (font (size 1.0 1.0))))(property "Footprint" "MonitorPowerLocal:Package_TO_SOT_THT_TO-92_Inline_Wide" (at 485.14 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "MCP1702-3302E/TO" (at 485.14 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "TO-92 pin numbering is 1 GND, 2 VIN, 3 VOUT. Wide 2.54 mm footprint requires forming the outer leads from nominal 1.27 mm spacing; support the body while forming. Budget 30 mA maximum total 3.3 V load. Include output, load and line regulation. Do not parallel existing ISOW7741 output." (at 485.14 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "MonitorPowerLocal:Package_TO_SOT_THT_TO-92_Inline_Wide" (at 485.14 119.38 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "9234e427-e6b3-4bc2-bdae-33ae80917c56")) (pin "2" (uuid "870e0344-0452-4746-a1fd-c5a8ea6fc94b")) (pin "3" (uuid "beefbee6-0f44-492e-950e-8812e7953cca"))(instances (project "Monitor_Power_C1" (path "/ac757bb2-b6c1-4155-aa1b-bd1d9377b81c" (reference "U201") (unit 1)))))

(symbol (lib_id "MonitorPowerReview:Part_F202") (at 345.44 76.2 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "eddced95-ac5f-4231-b1f9-e5fdcc464178") (property "Reference" "F202" (at 345.44 67.31 0) (effects (font (size 1.0 1.0))))(property "Value" "500mA_SLOW_125VDC" (at 345.44 69.85 0) (effects (font (size 1.0 1.0))))(property "Footprint" "MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453" (at 345.44 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "0454.500MR" (at 345.44 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "500 mA slow fuse, matching the TMR 1 recommended 5 V input fuse. 125 VAC/DC, 50 A interrupt at 125 V; 300 A at 32 VDC. Nominal cold resistance 0.700 ohm; I2t 0.240 A2s is nominal, not a startup coordination guarantee. Selected footprint pads match the 452/454 recommended 1.96 x 3.15 mm lands, 2.95 mm inner gap. Use an SMD adapter for perfboard." (at 345.44 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453" (at 345.44 76.2 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "c191add7-f5fe-46c5-9ffe-edba67c2518b")) (pin "2" (uuid "1aacb329-91b4-44b5-8a45-2364c4ceaf36"))(instances (project "Monitor_Power_C1" (path "/ac757bb2-b6c1-4155-aa1b-bd1d9377b81c" (reference "F202") (unit 1)))))

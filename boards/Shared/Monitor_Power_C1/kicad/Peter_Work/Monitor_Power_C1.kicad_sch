(symbol (lib_id "MonitorPowerReview:Part_F201") (at 205.74 76.2 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "0752fe72-69d3-45a2-9bbe-23f734192b83") (property "Reference" "F201" (at 205.74 67.31 0) (effects (font (size 1.0 1.0))))(property "Value" "2A_SLOW_125VDC" (at 205.74 69.85 0) (effects (font (size 1.0 1.0))))(property "Footprint" "MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453" (at 205.74 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "0454002.MR" (at 205.74 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "2 A slow fuse per TMR 3 5 V input recommendation. 125 VAC/DC, 50 A interrupt at 125 V; 300 A at 32 VDC. Nominal cold resistance 0.0625 ohm, nominal I2t 8.20 A2s. Same verified 452/454 lands. Startup coordination is still a measurement, not implied by nominal I2t." (at 205.74 76.2 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453" (at 205.74 76.2 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "babe73fc-aacd-4e48-a956-5e139de10359")) (pin "2" (uuid "f60c7eff-87b9-4b33-b6b3-5cc27c517423"))(instances (project "Monitor_Power_C1" (path "/ac757bb2-b6c1-4155-aa1b-bd1d9377b81c" (reference "F201") (unit 1)))))

(symbol (lib_id "MonitorPowerReview:Part_PS202") (at 66.04 119.38 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "eaf9b146-9b21-4c81-951e-184bb3762219") (property "Reference" "PS202" (at 66.04 110.49 0) (effects (font (size 1.0 1.0))))(property "Value" "ISOLATED_REGULATED_5V_200mA" (at 66.04 113.03 0) (effects (font (size 1.0 1.0))))(property "Footprint" "MonitorPowerLocal:Converter_DCDC_Converter_DCDC_TRACO_TMR-1-xxxx_Single_THT" (at 66.04 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "TMR 1-0511" (at 66.04 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "Single isolated output, NOT the dual-output part. 1 W, 5 V / 200 mA; 4.5 to 9 V at module input pins. Pins 3 and 5 are absent. Two independent output pairs are series-connected only at this channel MID. MID terminal is passive for ERC because it is the selected output reference. Body 17 x 7.62 x 11 mm; pin locations 0, 2.54, 7.62, 12.70 mm. Bench design, not a medical isolation certification." (at 66.04 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "MonitorPowerLocal:Converter_DCDC_Converter_DCDC_TRACO_TMR-1-xxxx_Single_THT" (at 66.04 119.38 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "8b241e57-d9ff-44e0-9d10-5e6eed717fdd")) (pin "2" (uuid "3ad8b19d-19ba-4ba4-acf0-ce2c0a2e0dfe")) (pin "4" (uuid "4fa70fda-79d8-45df-aa92-77ee2cd3fa67")) (pin "6" (uuid "be8e1f67-681f-4371-a3fc-109364556abf"))(instances (project "Monitor_Power_C1" (path "/ac757bb2-b6c1-4155-aa1b-bd1d9377b81c" (reference "PS202") (unit 1)))))

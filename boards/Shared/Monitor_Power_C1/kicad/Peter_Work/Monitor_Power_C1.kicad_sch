(symbol (lib_id "MonitorPowerReview:Part_R202") (at 345.44 119.38 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "2d1a26e6-6a88-43a9-aeee-ecf464ab098b") (property "Reference" "R202" (at 345.44 111.76 0) (effects (font (size 1.0 1.0))))(property "Value" "220R_1%_0.6W" (at 345.44 114.3 0) (effects (font (size 1.0 1.0))))(property "Footprint" "MonitorPowerLocal:Resistor_THT_R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal" (at 345.44 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "MRS25000C2200FRP00" (at 345.44 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "Standalone rail preload. 220 ohm, 1%, 50 ppm/K, 0.6 W at 70 C. Body maximum 6.5 x 2.5 mm, 0.6 mm leads; selected 10.16 mm pitch exceeds the 10 mm minimum bend spacing. This is additional to the sensing core 470 ohm bleeders. Use 220 rather than 240 ohm to remain above 20 mA at the stated low rail corner." (at 345.44 119.38 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "MonitorPowerLocal:Resistor_THT_R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal" (at 345.44 119.38 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "93d833fe-ce4b-4471-b2d5-1f0afc3711f3")) (pin "2" (uuid "26d516f0-ccf7-4a2c-b88b-ca4516277d6b"))(instances (project "Monitor_Power_C1" (path "/ac757bb2-b6c1-4155-aa1b-bd1d9377b81c" (reference "R202") (unit 1)))))

    <comp ref="F202">
      <value>500mA_SLOW_125VDC</value>
      <footprint>MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453</footprint>
      <fields>
        <field name="MPN">0454.500MR</field>
        <field name="Design notes">500 mA slow fuse, matching the TMR 1 recommended 5 V input fuse. 125 VAC/DC, 50 A interrupt at 125 V; 300 A at 32 VDC. Nominal cold resistance 0.700 ohm; I2t 0.240 A2s is nominal, not a startup coordination guarantee. Selected footprint pads match the 452/454 recommended 1.96 x 3.15 mm lands, 2.95 mm inner gap. Use an SMD adapter for perfboard.</field>
        <field name="Footprint candidate">MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453</field>
        <field name="Footprint">MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453</field>
        <field name="Datasheet"/>
        <field name="Description"/>
      </fields>
      <libsource lib="MonitorPowerReview" part="Part_F202" description=""/>
      <property name="MPN" value="0454.500MR"/>
      <property name="Design notes" value="500 mA slow fuse, matching the TMR 1 recommended 5 V input fuse. 125 VAC/DC, 50 A interrupt at 125 V; 300 A at 32 VDC. Nominal cold resistance 0.700 ohm; I2t 0.240 A2s is nominal, not a startup coordination guarantee. Selected footprint pads match the 452/454 recommended 1.96 x 3.15 mm lands, 2.95 mm inner gap. Use an SMD adapter for perfboard."/>
      <property name="Footprint candidate" value="MonitorPowerLocal:Fuse_Fuse_Littelfuse-NANO2-451_453"/>

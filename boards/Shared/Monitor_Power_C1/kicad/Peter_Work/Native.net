    <comp ref="J201">
      <value>SYSTEM_5V_INPUT</value>
      <footprint>MonitorPowerLocal:Connector_JST_JST_VH_B2P-VH_1x02_P3.96mm_Vertical</footprint>
      <fields>
        <field name="MPN">B2P-VH(LF)(SN)</field>
        <field name="Design notes">Primary side only. Mate VHR-2N with SVH-41T-P1.1 contacts. Standard VH header rating is 10 A with 16 AWG wire, 250 VAC/DC; this channel branch is allocated less than 1 A. Verify crimp and pin orientation. Never join SYS_GND to MID_CH.</field>
        <field name="Footprint candidate">MonitorPowerLocal:Connector_JST_JST_VH_B2P-VH_1x02_P3.96mm_Vertical</field>

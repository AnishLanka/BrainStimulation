    <comp ref="J202">
      <value>LOCAL_MONITOR_POWER</value>
      <footprint>MonitorPowerLocal:Connector_JST_JST_VH_B4P-VH_1x04_P3.96mm_Vertical</footprint>
      <fields>
        <field name="MPN">B4P-VH(LF)(SN)</field>
        <field name="Design notes">Output harness only for this channel. Mate VHR-4N with SVH-41T-P1.1 contacts. Pin map is the project harness convention: 1 +5, 2 MID, 3 -5, 4 +3.3. Do not attach SYS_GND or another channel MID. Do not parallel existing IA0305S or ISOW7741 supply outputs.</field>

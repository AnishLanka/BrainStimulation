(version 1)
(rule "Copper spacing" (constraint clearance (min 0.2mm)))
(rule "Host to channel separation" (condition "((A.NetName == '/HOST_3V3' || A.NetName == '/HOST_ARM' || A.NetName == '/HOST_FAULT_OK' || A.NetName == '/HOST_GND' || A.NetName == '/HOST_HB' || A.NetName == '/HOST_RUN' || A.NetName == '/HOST_UART_RX' || A.NetName == '/HOST_UART_TX') && (B.NetName == '/ADC_CS_N' || B.NetName == '/ADC_REF_A' || B.NetName == '/ADC_REF_B' || B.NetName == '/ADC_SCLK' || B.NetName == '/ADC_SDI' || B.NetName == '/ADC_SDO_A' || B.NetName == '/ADC_SDO_B' || B.NetName == '/ARM_EDGE' || B.NetName == '/FAULT_CLEAR_N' || B.NetName == '/HEARTBEAT' || B.NetName == '/INHIBITED' || B.NetName == '/ISOLATED_HOST_RUN' || B.NetName == '/I_ADC_N' || B.NetName == '/I_ADC_P' || B.NetName == '/I_F1A' || B.NetName == '/I_F1B' || B.NetName == '/I_F2A' || B.NetName == '/I_F2B' || B.NetName == '/I_HALF' || B.NetName == '/I_LP1' || B.NetName == '/I_LP2' || B.NetName == '/I_MON' || B.NetName == '/LOCAL_READY' || B.NetName == '/MID_CH_GND' || B.NetName == '/P3V3_CH' || B.NetName == '/P5_CH' || B.NetName == '/PICO_3V3' || B.NetName == '/PICO_ADC_CS_N' || B.NetName == '/PICO_ADC_SCLK' || B.NetName == '/PICO_ADC_SDI' || B.NetName == '/PICO_ADC_SDO_A' || B.NetName == '/PICO_ADC_SDO_B' || B.NetName == '/PICO_FAULT_OK' || B.NetName == '/PICO_INHIBITED' || B.NetName == '/PICO_UART_RX' || B.NetName == '/PICO_UART_TX' || B.NetName == '/REF_A_CAP' || B.NetName == '/REF_B_CAP' || B.NetName == '/RUN_REQUEST' || B.NetName == '/V_ADC_N' || B.NetName == '/V_ADC_P' || B.NetName == '/V_F1A' || B.NetName == '/V_F1B' || B.NetName == '/V_F2A' || B.NetName == '/V_F2B' || B.NetName == '/V_HALF' || B.NetName == '/V_LP1' || B.NetName == '/V_LP2' || B.NetName == '/V_MON')) || ((A.NetName == '/ADC_CS_N' || A.NetName == '/ADC_REF_A' || A.NetName == '/ADC_REF_B' || A.NetName == '/ADC_SCLK' || A.NetName == '/ADC_SDI' || A.NetName == '/ADC_SDO_A' || A.NetName == '/ADC_SDO_B' || A.NetName == '/ARM_EDGE' || A.NetName == '/FAULT_CLEAR_N' || A.NetName == '/HEARTBEAT' || A.NetName == '/INHIBITED' || A.NetName == '/ISOLATED_HOST_RUN' || A.NetName == '/I_ADC_N' || A.NetName == '/I_ADC_P' || A.NetName == '/I_F1A' || A.NetName == '/I_F1B' || A.NetName == '/I_F2A' || A.NetName == '/I_F2B' || A.NetName == '/I_HALF' || A.NetName == '/I_LP1' || A.NetName == '/I_LP2' || A.NetName == '/I_MON' || A.NetName == '/LOCAL_READY' || A.NetName == '/MID_CH_GND' || A.NetName == '/P3V3_CH' || A.NetName == '/P5_CH' || A.NetName == '/PICO_3V3' || A.NetName == '/PICO_ADC_CS_N' || A.NetName == '/PICO_ADC_SCLK' || A.NetName == '/PICO_ADC_SDI' || A.NetName == '/PICO_ADC_SDO_A' || A.NetName == '/PICO_ADC_SDO_B' || A.NetName == '/PICO_FAULT_OK' || A.NetName == '/PICO_INHIBITED' || A.NetName == '/PICO_UART_RX' || A.NetName == '/PICO_UART_TX' || A.NetName == '/REF_A_CAP' || A.NetName == '/REF_B_CAP' || A.NetName == '/RUN_REQUEST' || A.NetName == '/V_ADC_N' || A.NetName == '/V_ADC_P' || A.NetName == '/V_F1A' || A.NetName == '/V_F1B' || A.NetName == '/V_F2A' || A.NetName == '/V_F2B' || A.NetName == '/V_HALF' || A.NetName == '/V_LP1' || A.NetName == '/V_LP2' || A.NetName == '/V_MON') && (B.NetName == '/HOST_3V3' || B.NetName == '/HOST_ARM' || B.NetName == '/HOST_FAULT_OK' || B.NetName == '/HOST_GND' || B.NetName == '/HOST_HB' || B.NetName == '/HOST_RUN' || B.NetName == '/HOST_UART_RX' || B.NetName == '/HOST_UART_TX'))") (constraint clearance (min 3.5mm)))

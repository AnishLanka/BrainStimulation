(symbol (lib_id "ADCReview:Part_U207") (at 345.44 417.83 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "cdf2fb0f-273c-4282-baa6-34c7c42a9f8b") (property "Reference" "U207" (at 345.44 386.08 0) (effects (font (size 1.0 1.0))))(property "Value" "Raspberry Pi Pico RP2040" (at 345.44 388.62 0) (effects (font (size 1.0 1.0))))(property "Footprint" "Module:RaspberryPi_Pico_Common_THT" (at 345.44 417.83 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "MPN" "SC0915" (at 345.44 417.83 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Design notes" "Local sampler module/header. Pin39 VSYS=isolated5V; on-board3V3_OUT isPICO_3V3 and must NOT parallel coreP3V3_CH. VBUS40,3V3_EN37 andADC_VREF35 unconnected. No USB/SWD/ground cable to a host during isolated operation; use isolated UART for runtime. Installed KiCad common THT footprint is the socketed prototype candidate; verify module orientation and clearance." (at 345.44 417.83 0) (effects (font (size 1.0 1.0)) (hide yes)))(property "Footprint candidate" "Module:RaspberryPi_Pico_Common_THT" (at 345.44 417.83 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid "4a5efd8d-4754-41c5-9bd7-f2c7d7b7bc66")) (pin "2" (uuid "8c5818c9-e8fa-45c8-b602-561f665cefea")) (pin "3" (uuid "632b9416-d645-4757-92f9-79ff969dc4e8")) (pin "4" (uuid "5ff741ab-b885-4562-8d59-154d39fb6844")) (pin "5" (uuid "55e6d0e9-d84d-435e-9f29-e48cd3661e41")) (pin "6" (uuid "a9a1a451-89ee-4ec2-8989-8e84cafdbe71")) (pin "7" (uuid "249254f4-70e3-40c3-86bb-019dddfe5a50")) (pin "8" (uuid "55af8042-5707-493b-b9f5-1cd2b96b5597")) (pin "9" (uuid "e5cae10f-2875-4009-9e75-16518ca3c7d6")) (pin "10" (uuid "41aeb329-cc3f-424e-a866-bdf0a3fb1fcd")) (pin "11" (uuid "ba9ba986-ee1a-41a3-bcfb-da3812f879d9")) (pin "12" (uuid "d656b712-e632-436c-bbd2-9f9e0449acae")) (pin "13" (uuid "de24ac9b-403c-4049-9480-65c118af38b0")) (pin "14" (uuid "0f4e4059-7ae6-4f49-9a3d-4829b2c35e39")) (pin "15" (uuid "1135f946-3fd3-495e-8480-a61ade9cfa1f"))
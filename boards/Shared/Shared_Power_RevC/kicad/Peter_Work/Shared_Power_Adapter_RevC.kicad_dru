(rule "Isolated domain spacing 1-2" (condition "((A.NetName == '/CH1_12V' || A.NetName == '/CH1_HV_BOTTOM' || A.NetName == 'unconnected-(PS1-NC-Pad5)') && (B.NetName == '/CH2_12V' || B.NetName == '/CH2_HV_BOTTOM' || B.NetName == 'unconnected-(PS2-NC-Pad5)')) || ((A.NetName == '/CH2_12V' || A.NetName == '/CH2_HV_BOTTOM' || A.NetName == 'unconnected-(PS2-NC-Pad5)') && (B.NetName == '/CH1_12V' || B.NetName == '/CH1_HV_BOTTOM' || B.NetName == 'unconnected-(PS1-NC-Pad5)'))") (constraint clearance (min 3.5mm)))
(rule "Isolated domain spacing 1-3" (condition "((A.NetName == '/CH1_12V' || A.NetName == '/CH1_HV_BOTTOM' || A.NetName == 'unconnected-(PS1-NC-Pad5)') && (B.NetName == '/CH3_12V' || B.NetName == '/CH3_HV_BOTTOM' || B.NetName == 'unconnected-(PS3-NC-Pad5)')) || ((A.NetName == '/CH3_12V' || A.NetName == '/CH3_HV_BOTTOM' || A.NetName == 'unconnected-(PS3-NC-Pad5)') && (B.NetName == '/CH1_12V' || B.NetName == '/CH1_HV_BOTTOM' || B.NetName == 'unconnected-(PS1-NC-Pad5)'))") (constraint clearance (min 3.5mm)))
(rule "Isolated domain spacing 1-4" (condition "((A.NetName == '/CH1_12V' || A.NetName == '/CH1_HV_BOTTOM' || A.NetName == 'unconnected-(PS1-NC-Pad5)') && (B.NetName == '/CH4_12V' || B.NetName == '/CH4_HV_BOTTOM' || B.NetName == 'unconnected-(PS4-NC-Pad5)')) || ((A.NetName == '/CH4_12V' || A.NetName == '/CH4_HV_BOTTOM' || A.NetName == 'unconnected-(PS4-NC-Pad5)') && (B.NetName == '/CH1_12V' || B.NetName == '/CH1_HV_BOTTOM' || B.NetName == 'unconnected-(PS1-NC-Pad5)'))") (constraint clearance (min 3.5mm)))
(rule "Isolated domain spacing 2-3" (condition "((A.NetName == '/CH2_12V' || A.NetName == '/CH2_HV_BOTTOM' || A.NetName == 'unconnected-(PS2-NC-Pad5)') && (B.NetName == '/CH3_12V' || B.NetName == '/CH3_HV_BOTTOM' || B.NetName == 'unconnected-(PS3-NC-Pad5)')) || ((A.NetName == '/CH3_12V' || A.NetName == '/CH3_HV_BOTTOM' || A.NetName == 'unconnected-(PS3-NC-Pad5)') && (B.NetName == '/CH2_12V' || B.NetName == '/CH2_HV_BOTTOM' || B.NetName == 'unconnected-(PS2-NC-Pad5)'))") (constraint clearance (min 3.5mm)))

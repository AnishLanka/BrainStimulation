(version 1)
(rule "General copper spacing" (constraint clearance (min 0.2mm)))
(rule "Isolated domain spacing 0-1" (condition "((A.NetName == '/3V3_A' || A.NetName == '/3V3_B' || A.NetName == '/AUX5V' || A.NetName == '/FB_A' || A.NetName == '/FB_B' || A.NetName == '/L1_A' || A.NetName == '/L1_B' || A.NetName == '/L2_A' || A.NetName == '/L2_B' || A.NetName == '/P5V_CH1' || A.NetName == '/P5V_CH2' || A.NetName == '/P5V_CH3' || A.NetName == '/P5V_CH4' || A.NetName == '/P5V_IN' || A.NetName == '/P5V_LOGIC_A' || A.NetName == '/P5V_LOGIC_B' || A.NetName == '/P5V_RAW' || A.NetName == '/PG_A' || A.NetName == '/PG_B' || A.NetName == '/SYS_GND' || A.NetName == 'unconnected-(PS1-CTRL-Pad4)' || A.NetName == 'unconnected-(PS2-CTRL-Pad4)' || A.NetName == 'unconnected-(PS3-CTRL-Pad4)' || A.NetName == 'unconnected-(PS4-CTRL-Pad4)') && (B.NetName == '/CH1_12V' || B.NetName == '/CH1_HV_BOTTOM' || B.NetName == 'unconnected-(PS1-NC-Pad5)')) || ((A.NetName == '/CH1_12V' || A.NetName == '/CH1_HV_BOTTOM' || A.NetName == 'unconnected-(PS1-NC-Pad5)') && (B.NetName == '/3V3_A' || B.NetName == '/3V3_B' || B.NetName == '/AUX5V' || B.NetName == '/FB_A' || B.NetName == '/FB_B' || B.NetName == '/L1_A' || B.NetName == '/L1_B' || B.NetName == '/L2_A' || B.NetName == '/L2_B' || B.NetName == '/P5V_CH1' || B.NetName == '/P5V_CH2' || B.NetName == '/P5V_CH3' || B.NetName == '/P5V_CH4' || B.NetName == '/P5V_IN' || B.NetName == '/P5V_LOGIC_A' || B.NetName == '/P5V_LOGIC_B' || B.NetName == '/P5V_RAW' || B.NetName == '/PG_A' || B.NetName == '/PG_B' || B.NetName == '/SYS_GND' || B.NetName == 'unconnected-(PS1-CTRL-Pad4)' || B.NetName == 'unconnected-(PS2-CTRL-Pad4)' || B.NetName == 'unconnected-(PS3-CTRL-Pad4)' || B.NetName == 'unconnected-(PS4-CTRL-Pad4)'))") (constraint clearance (min 3.5mm)))
(rule "Isolated domain spacing 0-2" (condition "((A.NetName == '/3V3_A' || A.NetName == '/3V3_B' || A.NetName == '/AUX5V' || A.NetName == '/FB_A' || A.NetName == '/FB_B' || A.NetName == '/L1_A' || A.NetName == '/L1_B' || A.NetName == '/L2_A' || A.NetName == '/L2_B' || A.NetName == '/P5V_CH1' || A.NetName == '/P5V_CH2' || A.NetName == '/P5V_CH3' || A.NetName == '/P5V_CH4' || A.NetName == '/P5V_IN' || A.NetName == '/P5V_LOGIC_A' || A.NetName == '/P5V_LOGIC_B' || A.NetName == '/P5V_RAW' || A.NetName == '/PG_A' || A.NetName == '/PG_B' || A.NetName == '/SYS_GND' || A.NetName == 'unconnected-(PS1-CTRL-Pad4)' || A.NetName == 'unconnected-(PS2-CTRL-Pad4)' || A.NetName == 'unconnected-(PS3-CTRL-Pad4)' || A.NetName == 'unconnected-(PS4-CTRL-Pad4)') && (B.NetName == '/CH2_12V' || B.NetName == '/CH2_HV_BOTTOM' || B.NetName == 'unconnected-(PS2-NC-Pad5)')) || ((A.NetName == '/CH2_12V' || A.NetName == '/CH2_HV_BOTTOM' || A.NetName == 'unconnected-(PS2-NC-Pad5)') && (B.NetName == '/3V3_A' || B.NetName == '/3V3_B' || B.NetName == '/AUX5V' || B.NetName == '/FB_A' || B.NetName == '/FB_B' || B.NetName == '/L1_A' || B.NetName == '/L1_B' || B.NetName == '/L2_A' || B.NetName == '/L2_B' || B.NetName == '/P5V_CH1' || B.NetName == '/P5V_CH2' || B.NetName == '/P5V_CH3' || B.NetName == '/P5V_CH4' || B.NetName == '/P5V_IN' || B.NetName == '/P5V_LOGIC_A' || B.NetName == '/P5V_LOGIC_B' || B.NetName == '/P5V_RAW' || B.NetName == '/PG_A' || B.NetName == '/PG_B' || B.NetName == '/SYS_GND' || B.NetName == 'unconnected-(PS1-CTRL-Pad4)' || B.NetName == 'unconnected-(PS2-CTRL-Pad4)' || B.NetName == 'unconnected-(PS3-CTRL-Pad4)' || B.NetName == 'unconnected-(PS4-CTRL-Pad4)'))") (constraint clearance (min 3.5mm)))

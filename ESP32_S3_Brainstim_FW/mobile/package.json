{
  "name": "r2d2-ble-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node scripts/build.mjs --web",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "add:android": "npm run build && cap add android && node scripts/permissions.mjs",
    "add:ios": "npm run build && cap add ios    && node scripts/permissions.mjs",
    "sync": "npm run build && node scripts/permissions.mjs && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2",
    "typescript": "5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
